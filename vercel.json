{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "mails/**"
    }
  },
  "rewrites": [
    { "source": "/api/register",       "destination": "/api/register" },
    { "source": "/api/registrations",  "destination": "/api/registrations" },
    { "source": "/admin-dashboard",    "destination": "/api/dashboard" },
    { "source": "/about",              "destination": "/about.html" },
    { "source": "/privacy",            "destination": "/privacy.html" },
    { "source": "/sitemap.xml",        "destination": "/sitemap.xml" },
    { "source": "/robots.txt",         "destination": "/robots.txt" },
    { "source": "/((?!api/|about|privacy|admin-dashboard|sitemap\\.xml|robots\\.txt).*)",       "destination": "/index.html" }
  ]
}
